SECRET_KEY=replace-with-a-long-random-production-secret
DATA_DIR=instance
SQLITE_DB_PATH=instance/minante.db
# For Render, set DATABASE_URL to the database's Internal Database URL.
# Leave unset locally to use SQLite, or use a local PostgreSQL URL to test PG.
# DATABASE_URL=postgresql://username:password@host:5432/database
SESSION_COOKIE_SECURE=0
FLASK_DEBUG=0

# Minimum subgroup size shown in the confidential aggregate demographic report.
LGBTQIA_REPORT_MIN_GROUP_SIZE=5

# Render also uses this persistent disk for private uploaded files:
# DATA_DIR=/var/data
# SESSION_COOKIE_SECURE=1
